# 환경변수 예시 파일 (이 파일은 커밋해도 됨 — 실제 값 X)
# 사용법: 이 파일을 복사해 .env 로 만들고 실제 값을 채운다.  cp .env.example .env
# .env 는 .gitignore 에 등록되어 커밋되지 않는다.
# 형식은 properties 규칙(KEY=VALUE). 따옴표/export 접두사 사용 금지, 한 줄에 하나.

# 카카오 로그인 (카카오 개발자센터에서 발급)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
OPEN_AI_KEY=
# DB (Supabase PostgreSQL)
# 기본 url 은 Direct connection(IPv6 전용)이라, 보통은 DB_PASSWORD 만 채우면 된다.
# 다만 IPv4 망(대부분의 로컬/공유기)이면 Session Pooler 를 써야 한다 → 아래 3개를 모두 설정:
#   Supabase 대시보드 → Connect → "Session pooler" 문자열을 복사해 아래처럼 매핑
#   DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
#   DB_USERNAME=
DB_PASSWORD=여기에_Supabase_DB_비밀번호

# 포트원(PortOne) V2 결제
#   포트원 콘솔(admin.portone.io) → 결제연동 탭에서 발급
#   - PORTONE_API_SECRET    : V2 API Secret (서버 전용 비밀, 절대 노출 금지)
#   - PORTONE_WEBHOOK_SECRET: 웹훅 시크릿(whsec_... 형식). 웹훅 등록 시 발급됨
#   - PORTONE_STORE_ID      : 상점 ID(store-... 공개값, 참고용)
PORTONE_API_SECRET=여기에_포트원_V2_API_시크릿
PORTONE_WEBHOOK_SECRET=여기에_포트원_웹훅_시크릿
PORTONE_STORE_ID=store-여기에_상점ID

# 심사용 테스트 로그인 (카카오 로그인만 있는데 심사기관이 아이디/비밀번호를 요구할 때)
#   - 심사 기간에만 TEST_LOGIN_ENABLED=true 로 두고, 끝나면 false 로 내린다.
#   - 프론트에도 NEXT_PUBLIC_TEST_LOGIN=1 을 켜야 로그인 화면에 입력칸이 보인다.
#   - 비밀번호는 길고 무작위로. 심사가 끝나면 바꾸거나 계정을 지운다.
TEST_LOGIN_ENABLED=false
TEST_LOGIN_EMAIL=
TEST_LOGIN_PASSWORD=
