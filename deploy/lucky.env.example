# EC2 운영 환경변수 템플릿.
# 사용법: 이 내용을 EC2의 /etc/lucky/lucky.env 로 만들고 실제 값 채운 뒤 chmod 600.
# 기본 프로파일이 운영이므로 SPRING_PROFILES_ACTIVE 는 설정하지 않는다(설정 시 절대 local 금지).
# 형식은 KEY=VALUE, 따옴표/export 없이 한 줄에 하나.

DB_URL=jdbc:postgresql://aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.dfvodhavupoeznjdnshw
DB_PASSWORD=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
OPEN_AI_KEY=

# 포트원 V2 (admin.portone.io > 결제연동)
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_STORE_ID=

# 심사용 테스트 로그인 (결제사·스토어 심사에서 아이디/비밀번호를 요구할 때만)
#   - 심사 기간에만 true. 끝나면 false 로 내리고 systemctl restart lucky.
#   - 비밀번호는 길고 무작위로. systemd EnvironmentFile 이라 따옴표 없이 한 줄,
#     값에 # 이나 공백은 넣지 말 것(주석·구분자로 잘려 나간다).
#   - 프론트(Vercel)에도 NEXT_PUBLIC_TEST_LOGIN=1 을 켜야 로그인 화면에 입력칸이 보인다.
TEST_LOGIN_ENABLED=false
TEST_LOGIN_EMAIL=
TEST_LOGIN_PASSWORD=
