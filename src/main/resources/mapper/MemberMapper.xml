<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lucky.member.mapper.MemberMapper">

    <resultMap id="memberResultMap" type="com.lucky.member.domain.Member">
        <id property="id" column="id"/>
        <result property="kakaoId" column="kakao_id"/>
        <result property="nickname" column="nickname"/>
        <result property="role" column="role"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByKakaoId" parameterType="long" resultMap="memberResultMap">
        SELECT id, kakao_id, nickname, role, created_at, updated_at
        FROM members
        WHERE kakao_id = #{kakaoId}
    </select>

    <insert id="insert" parameterType="com.lucky.member.domain.Member"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO members (kakao_id, nickname, role, created_at, updated_at)
        VALUES (#{kakaoId}, #{nickname}, #{role}, NOW(), NOW())
    </insert>

    <update id="updateNickname" parameterType="com.lucky.member.domain.Member">
        UPDATE members
        SET nickname = #{nickname}, updated_at = NOW()
        WHERE kakao_id = #{kakaoId}
    </update>


    <!--
      탈퇴. kakao_id 를 '절대 겹치지 않는 값'으로 덮어 원래 카카오 회원번호를 지운다.
      비우지 못하는 이유는 NOT NULL·UNIQUE 이기 때문이고, 큰 음수 오프셋을 쓰는 이유는
      실제 카카오 회원번호(양수)와도, 심사용 테스트 계정(-1)과도 부딪히지 않게 하기 위함이다.
      결과적으로 같은 카카오 계정으로 다시 로그인하면 새 회원으로 가입된다.
    -->
    <update id="withdraw">
        UPDATE members
        SET kakao_id    = -1000000000000 - id,
            nickname    = NULL,
            withdrawn_at = now(),
            updated_at  = now()
        WHERE id = #{memberId}
          AND withdrawn_at IS NULL
    </update>

</mapper>
